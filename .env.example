# --- IA (ADR-005: local-first, Ollama como requisito) ---
# Provider de IA: ollama (por defecto) | lmstudio | ollama-cloud | anthropic
VITE_AI_PROVIDER=ollama
# URL base del provider (Ollama local por defecto)
VITE_AI_BASE_URL=http://localhost:11434
# Modelo a utilizar.
# ⚠️ Por defecto `gpt-oss:120b-cloud` es un modelo -cloud: Ollama reenvía los
# prompts a ollama.com (requiere `ollama signin`). Se usa por su calidad.
# Para privacidad 100% en tu máquina (prompts que NO salen), usa un modelo
# genuinamente local, p. ej.: VITE_AI_MODEL=llama3.2
VITE_AI_MODEL=gpt-oss:120b-cloud

# --- Observabilidad ---
# Sentry DSN (opcional en desarrollo, recomendado en producción)
VITE_SENTRY_DSN=
# Versión de la app para Sentry releases (en CI se inyecta el SHA del commit)
VITE_APP_VERSION=0.0.0
